# GEMINI_API_KEY: Optionnel — clé API Gemini côté serveur si des fonctions IA sont ajoutées ultérieurement.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL publique de l'application (ex: https://cherifbalde.com).
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Mot de passe administrateur côté serveur (recommandé en production).
# Si laissé vide en développement, un formulaire de configuration initiale s'affiche sur /admin.
ADMIN_PASSCODE=

# RESEND_API_KEY: Optionnel — clé API Resend (https://resend.com) pour envoyer réellement les messages de contact par e-mail.
RESEND_API_KEY=

# CONTACT_FROM_EMAIL: Adresse d'expéditeur vérifiée sur Resend (ex: portfolio@cherifbalde.com).
CONTACT_FROM_EMAIL=

# CONTACT_TO_EMAIL: Adresse de réception des messages (par défaut: baldecherifnianao01@gmail.com).
CONTACT_TO_EMAIL=baldecherifnianao01@gmail.com

# VITE_GA_MEASUREMENT_ID: Optionnel — ID Google Analytics (ex: G-XXXXXXXXXX), activé uniquement avec consentement.
VITE_GA_MEASUREMENT_ID=
